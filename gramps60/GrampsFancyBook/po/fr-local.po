#: gramps60/GrampsFancyBook/GrampsFancyBook.gpr.py:14
msgid "Gramps Fancy Genealogical Book"
msgstr "Livre généalogique illustré pour Gramps"

#: gramps60/GrampsFancyBook/GrampsFancyBook.gpr.py:15
msgid "Generate a static HTML book archive for the selected reference family."
msgstr "Générer une archive contenant un livre HTML statique pour la famille de référence sélectionnée."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:29
msgid "Book"
msgstr "Livre"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:31
msgid "Reference family"
msgstr "Famille de référence"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:35
msgid "Maximum ancestry generations ('unlimited' or a number)"
msgstr "Nombre maximal de générations d’ascendance (« unlimited » ou un nombre)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:40
msgid "Maximum descendant generations ('unlimited' or a number)"
msgstr "Nombre maximal de générations de descendance (« unlimited » ou un nombre)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:44
msgid "Output format"
msgstr "Format de sortie"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:46
msgid "Automatic (use destination extension)"
msgstr "Automatique (selon l’extension du fichier)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:48
msgid "HTML book (ZIP archive)"
msgstr "Livre HTML (archive ZIP)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:50
msgid "JSON snapshot (development diagnostics)"
msgstr "Instantané JSON (diagnostic de développement)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:53
msgid "Automatic mode uses .zip for HTML books and .json for diagnostic snapshots."
msgstr "Le mode automatique utilise .zip pour les livres HTML et .json pour les instantanés de diagnostic."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:56
msgid "Output file"
msgstr "Fichier de sortie"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:59
msgid "Automatic mode uses .zip for HTML, or .json for the development snapshot."
msgstr "Le mode automatique utilise .zip pour le livre HTML ou .json pour l’instantané de développement."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:64
msgid "Replace an existing file"
msgstr "Remplacer un fichier existant"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:70
msgid "Select a reference family."
msgstr "Sélectionnez une famille de référence."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:95
msgid "Select a supported output format."
msgstr "Sélectionnez un format de sortie pris en charge."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:49
msgid "The reference family must have two known partners."
msgstr "La famille de référence doit avoir deux partenaires connus."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:90
msgid "Output already exists"
msgstr "Le fichier de sortie existe déjà"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:91
msgid "Choose another destination or enable 'Replace an existing file'."
msgstr "Choisissez une autre destination ou activez « Remplacer un fichier existant »."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:95
msgid "Book generation failed"
msgstr "La génération du livre a échoué"
