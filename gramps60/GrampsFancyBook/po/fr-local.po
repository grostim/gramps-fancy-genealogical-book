#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:32
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:37
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:42
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:55
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:69
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:80
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:105
#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:106
msgid "Book"
msgstr "Livre"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:34
msgid "Reference family"
msgstr "Famille de référence"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:39
msgid "Maximum ancestry generations ('unlimited' or a number)"
msgstr "Nombre maximal de générations d’ascendance (« unlimited » ou un nombre)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:44
msgid "Maximum descendant generations ('unlimited' or a number)"
msgstr "Nombre maximal de générations de descendance (« unlimited » ou un nombre)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:46
msgid "Book language"
msgstr "Langue du livre"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:47
msgid "Use Gramps language"
msgstr "Utiliser la langue de Gramps"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:48
msgid "French"
msgstr "Français"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:49
msgid "English"
msgstr "Anglais"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:52
msgid "Automatic mode follows the language configured in Gramps. If that language is not supported, the book uses English."
msgstr "Le mode automatique suit la langue configurée dans Gramps. Si cette langue n’est pas prise en charge, le livre utilise l’anglais."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:57
msgid "Output format"
msgstr "Format de sortie"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:59
msgid "Automatic (use destination extension)"
msgstr "Automatique (selon l’extension du fichier)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:61
msgid "HTML book (ZIP archive)"
msgstr "Livre HTML (archive ZIP)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:62
msgid "PDF book (LuaLaTeX)"
msgstr "Livre PDF (LuaLaTeX)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:64
msgid "JSON snapshot (development diagnostics)"
msgstr "Instantané JSON (diagnostic de développement)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:67
msgid "Automatic mode uses .pdf for PDF books, .zip for HTML books, and .json for diagnostic snapshots."
msgstr "Le mode automatique utilise .pdf pour les livres PDF, .zip pour les livres HTML et .json pour les instantanés de diagnostic."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:72
msgid "Allow extended PDF compilation (up to 30 minutes)"
msgstr "Autoriser une compilation PDF prolongée (jusqu’à 30 minutes)"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:76
msgid "Use this for long PDF books when the standard three-minute limit expires. Each LuaLaTeX pass is limited to ten minutes."
msgstr "À utiliser pour les longs livres PDF lorsque la limite standard de trois minutes est dépassée. Chaque passe LuaLaTeX est limitée à dix minutes."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:84
msgid "I understand this export may include private data and information about living people."
msgstr "Je comprends que cet export peut contenir des données privées et des informations sur des personnes vivantes."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:90
msgid "Gramps access permissions remain in force, but this report does not filter or anonymize readable data. Confirm that you are authorized to create and share this export."
msgstr "Les autorisations d’accès de Gramps restent appliquées, mais ce rapport ne filtre ni n’anonymise les données accessibles. Confirmez que vous êtes autorisé à créer et partager cet export."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:93
msgid "Privacy"
msgstr "Confidentialité"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:95
msgid "Output file"
msgstr "Fichier de sortie"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:101
msgid "Automatic mode uses .pdf for PDF, .zip for HTML, or .json for the development snapshot."
msgstr "Le mode automatique utilise .pdf pour le PDF, .zip pour le HTML ou .json pour l’instantané de développement."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:106
msgid "Replace an existing file"
msgstr "Remplacer un fichier existant"

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:112
msgid "Select a reference family."
msgstr "Sélectionnez une famille de référence."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:122
msgid "Maximum ancestry generations must be a non-negative integer or 'unlimited'."
msgstr "Le nombre maximal de générations d’ascendance doit être un entier positif ou nul, ou « illimité » (« unlimited »)."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:132
msgid "Maximum descendant generations must be a non-negative integer or 'unlimited'."
msgstr "Le nombre maximal de générations de descendance doit être un entier positif ou nul, ou « illimité » (« unlimited »)."

#: gramps60/GrampsFancyBook/GrampsFancyBookOptions.py:166
#: gramps60/GrampsFancyBook/GrampsFancyBook.py:240
msgid "Select a supported output format."
msgstr "Sélectionnez un format de sortie pris en charge."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:25
msgid "Select an HTML ZIP output file."
msgstr "Sélectionnez un fichier de sortie HTML ZIP."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:27
msgid "The HTML archive destination must end in .zip."
msgstr "Le fichier de sortie HTML doit se terminer par .zip."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:30
msgid "The HTML archive destination cannot be a directory."
msgstr "Le fichier de sortie HTML ne peut pas être un dossier."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:33
msgid "The HTML archive destination cannot be a symbolic link."
msgstr "Le fichier de sortie HTML ne peut pas être un lien symbolique."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:35
msgid "Select a PDF output file."
msgstr "Sélectionnez un fichier de sortie PDF."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:37
msgid "The PDF destination must end in .pdf."
msgstr "Le fichier de sortie PDF doit se terminer par .pdf."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:40
msgid "The PDF destination cannot be a directory."
msgstr "Le fichier de sortie PDF ne peut pas être un dossier."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:43
msgid "The PDF destination cannot be a symbolic link."
msgstr "Le fichier de sortie PDF ne peut pas être un lien symbolique."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:45
msgid "Select a JSON output file."
msgstr "Sélectionnez un fichier de sortie JSON."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:47
msgid "The output file must use the .json extension."
msgstr "Le fichier de sortie doit utiliser l’extension .json."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:50
msgid "The JSON destination cannot be a directory."
msgstr "Le fichier de sortie JSON ne peut pas être un dossier."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:53
msgid "The consistency report destination cannot be a directory."
msgstr "Le fichier du rapport de cohérence ne peut pas être un dossier."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:56
msgid "Family contains a child reference without a handle."
msgstr "La famille contient une référence d’enfant sans identifiant interne."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:62
msgid "Output directory does not exist:"
msgstr "Le dossier de sortie n’existe pas :"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:63
msgid "Output destination cannot be a directory:"
msgstr "La destination de sortie ne peut pas être un dossier :"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:64
msgid "No family exists for Gramps ID"
msgstr "Aucune famille ne correspond à l’identifiant Gramps"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:65
msgid "Family references an unavailable person:"
msgstr "La famille référence une personne indisponible :"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:149
msgid "Privacy warning not acknowledged"
msgstr "L’avertissement de confidentialité n’a pas été confirmé"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:151
msgid "Confirm that you are authorized to export and share data about living people and records marked private."
msgstr "Confirmez que vous êtes autorisé à exporter et partager des données sur des personnes vivantes et des enregistrements marqués privés."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:166
msgid "The reference family must have two known partners."
msgstr "La famille de référence doit avoir deux partenaires connus."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:243
msgid "Output already exists"
msgstr "Le fichier de sortie existe déjà"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:244
msgid "Choose another destination or enable 'Replace an existing file'."
msgstr "Choisissez une autre destination ou activez « Remplacer un fichier existant »."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:248
msgid "PDF output unavailable"
msgstr "Sortie PDF indisponible"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:249
msgid "LuaLaTeX is required to produce a PDF. Install TeX Live and make lualatex available on PATH."
msgstr "LuaLaTeX est nécessaire pour produire un PDF. Installez TeX Live et rendez lualatex disponible dans le PATH."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:261
msgid "PDF generation failed"
msgstr "La génération du PDF a échoué"

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:263
msgid "Book generation failed"
msgstr "La génération du livre a échoué"

#: gramps60/GrampsFancyBook/GrampsFancyBook.gpr.py:8
msgid "Gramps Fancy Genealogical Book"
msgstr "Livre généalogique illustré pour Gramps"

#: gramps60/GrampsFancyBook/GrampsFancyBook.gpr.py:10
msgid "Generate a PDF or static HTML book for the selected reference family. Exports may include readable private data and information about living people; confirm that you are authorized to create and share the file."
msgstr "Générer un livre PDF ou HTML statique pour la famille de référence sélectionnée. L’export peut inclure des données privées accessibles et des informations sur des personnes vivantes ; confirmez que vous êtes autorisé à créer et partager le fichier."

#: gramps60/GrampsFancyBook/GrampsFancyBook.py:202
msgid "LuaLaTeX could not compile the selected book."
msgstr "LuaLaTeX n’a pas pu compiler le livre sélectionné."

msgid "LuaLaTeX compilation timed out."
msgstr "La compilation LuaLaTeX a dépassé le délai maximal."

msgid "PDF references did not stabilize after five compilation passes."
msgstr "Les renvois du PDF ne se sont pas stabilisés après cinq passes de compilation."

msgid "PDF compilation reported unresolved references or overfull boxes."
msgstr "La compilation du PDF signale des renvois non résolus ou des dépassements de marge."

msgid "LuaLaTeX completed without producing a PDF file."
msgstr "LuaLaTeX s’est terminé sans produire de fichier PDF."

msgid "PDF compilation did not produce auxiliary files required to resolve references."
msgstr "La compilation du PDF n’a pas produit les fichiers auxiliaires nécessaires à la résolution des renvois."

msgid "LuaLaTeX did not produce a compilation log."
msgstr "LuaLaTeX n’a pas produit de journal de compilation."

msgid "LuaLaTeX could not produce a valid PDF."
msgstr "LuaLaTeX n’a pas pu produire un PDF valide."
